<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#1A73E8</item>
        <item name="android:colorPrimaryDark">#F6F8FC</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:colorControlHighlight">#241A73E8</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">#F6F8FC</item>
        <item name="android:navigationBarColor">#F6F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/AppActivityMotion</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <!-- Screens slide in slightly from the end edge while fading; back reverses it. -->
    <style name="AppActivityMotion" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:colorControlHighlight">#241A73E8</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowAnimationStyle">@style/AppDialogMotion</item>
    </style>

    <style name="AppDialogMotion" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
